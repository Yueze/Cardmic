<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime blocks audio input without this. Cardmic
         records from a virtual audio device for a moment to check that it
         loops sound back. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
